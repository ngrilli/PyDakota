[Physics/SolidMechanics/QuasiStatic/all]
  add_variables = false
  strain = FINITE
  incremental = true

  generate_output = 'strain_xx strain_xy strain_xz strain_yy strain_yz strain_zz
                     stress_xx stress_xy stress_xz stress_yy stress_yz stress_zz'
[]


[AuxKernels]
  [./euler_angle_1]
    type = MaterialRealVectorValueAux
    variable = euler_angle_1
    property = Euler_angles
    component = 0
    execute_on = timestep_end
  [../]

  [./euler_angle_2]
    type = MaterialRealVectorValueAux
    variable = euler_angle_2
    property = Euler_angles
    component = 1
    execute_on = timestep_end
  [../]
  [./euler_angle_3]
    type = MaterialRealVectorValueAux
    variable = euler_angle_3
    property = Euler_angles
    component = 2
    execute_on = timestep_end
  [../]
  [./fp_zz]
    type = RankTwoAux
    variable = fp_zz
    rank_two_tensor = plastic_deformation_gradient
    index_j = 2
    index_i = 2
    execute_on = timestep_end
  [../]
  [./gamma_out]
    type = MaterialRealAux
    variable = gamma_qp
    property = cumulative_slip
  [../]
[]

[BCs]
  # Symmetry/constraint planes (remove rigid body motion)
  [./x_left]
    type = DirichletBC
    variable = ux
    boundary = left
    value = 0.0
  [../]

  [./y_bottom]
    type = DirichletBC
    variable = uy
    boundary = bottom
    value = 0.0
  [../]

  [./z_back]
    type = DirichletBC
    variable = uz
    boundary = back
    value = 0.0
  [../]
  [./z_pull_front]
    type = FunctionDirichletBC
    variable = uz
    boundary = front
    function = uz_cyclic
[../]
[]


[Materials]
  [elasticity_tensor_copper]
    type = ComputeElasticityTensorCP
    C_ijkl = '1.7e5 1.24e5 1.24e5 1.7e5 1.24e5 1.7e5 0.75e5 0.75e5 0.75e5'
    fill_method = symmetric9
    read_prop_user_object = prop_read
  []
  [stress_copper]
    type = ComputeMultipleCrystalPlasticityStress
    crystal_plasticity_models = 'trial_xtalpl_copper'
    tan_mod_type = exact
    maxiter = 1000
    maximum_substep_iteration = 1
    rtol = 1e-5
    abs_tol = 1e-5
  []
  [trial_xtalpl_copper]
    type = CrystalPlasticityCopper
    number_slip_systems = 12
    slip_sys_file_name = input_slip_sys.txt
    gss_initial = 9.177
    gss_initial_std = 3.0
    t_sat = 33.0
    xm = 0.1
    ao = 0.001
    r = 1.4
    gss_a = 2.198364
    h = {h}
    slip_increment_tolerance = 0.02
    stol = 0.02
    resistance_tol = 0.01
    h_C = 7000.0
    h_D = 277.0
  []
[]

[UserObjects]
  [./prop_read]
    type = PropertyReadFile
    prop_file_name = 'Annealed_ukaea_nico_125.txt' 
    nprop = 3
    nblock = 125
    read_type = block
    use_zero_based_block_indexing = false
  [../]
[]


[Postprocessors]
  [avg_szz]
    type     = ElementAverageValue
    variable = stress_zz
  []

  [avg_ezz]
    type     = ElementAverageValue
    variable = strain_zz
  []
  [u_front_avg]
    type     = SideAverageValue
    variable = uz
    boundary = front
  []
  [strain_eng]
    type                  = ParsedPostprocessor
    pp_names              = 'u_front_avg'
    constant_names        = 'L0'
    constant_expressions  = '90.0'
    expression            = 'u_front_avg / L0'
  []
  [gamma_avg]
    type     = ElementAverageValue
    variable = gamma_qp
    # optionally restrict to the gauge block if you have one, e.g.:
    # block = 'gauge'
  [] 
  [dt_size]
    type = TimestepSize
  []
[]


[Preconditioning]
  [smp]
    type = SMP
    full = true
  []
[]

[Executioner]
  type = Transient
  solve_type = 'PJFNK'

  petsc_options_iname = '-pc_type -pc_hypre_type -ksp_gmres_restart'
  petsc_options_value = 'hypre    boomeramg          31'

  line_search = 'basic'
  automatic_scaling = true
  nl_abs_tol = 1e-10

  nl_max_its = 40
  l_max_its = 60
  nl_rel_tol = 1e-8

  [TimeStepper]
    type = IterationAdaptiveDTMax
    optimal_iterations = 25
    iteration_window = 15
    growth_factor = 1.15
    reject_large_step = true
    cutback_factor = 0.3

    dt = 0.001
    upper_limit_dt = 0.005
  []

  end_time = 100.0
  dtmin = 1e-20
[]


[Outputs]
  csv = true
  perf_graph = true

  [./exo_out]
    type = Exodus
    sync_times = '
