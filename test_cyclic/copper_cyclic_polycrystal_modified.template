[GlobalParams]
  displacements = 'ux uy uz'
[]

[Mesh]
  construct_side_list_from_node_list = true

  [./polycrystal_neper_mesh]
    type = FileMeshGenerator
    file = "rve125.msh"
  [../]

  [./x0_modifier]
    type = BoundingBoxNodeSetGenerator
    input = polycrystal_neper_mesh
    new_boundary = left
    top_right = '0.1 90.1 90.1'
    bottom_left = '-0.1 -0.1 -0.1'
  [../]

  [./y0_modifier]
    type = BoundingBoxNodeSetGenerator
    input = x0_modifier
    new_boundary = bottom
    top_right = '90.1 0.1 90.1'
    bottom_left = '-0.1 -0.1 -0.1'
  [../]

  [./z0_modifier]
    type = BoundingBoxNodeSetGenerator
    input = y0_modifier
    new_boundary = back
    top_right = '90.1 90.1 0.1'
    bottom_left = '-0.1 -0.1 -0.1'
  [../]

  [./x1_modifier]
    type = BoundingBoxNodeSetGenerator
    input = z0_modifier
    new_boundary = right
    top_right = '90.1 90.1 90.1'
    bottom_left = '89.9 -0.1 -0.1'
  [../]

  [./y1_modifier]
    type = BoundingBoxNodeSetGenerator
    input = x1_modifier
    new_boundary = top
    top_right = '90.1 90.1 90.1'
    bottom_left = '-0.1 89.9 -0.1'
  [../]

  [./z1_modifier]
    type = BoundingBoxNodeSetGenerator
    input = y1_modifier
    new_boundary = front
    top_right = '90.1 90.1 90.1'
    bottom_left = '-0.1 -0.1 89.9'
  [../]
[]


[Variables]
  [./ux]
    order = FIRST
    family = LAGRANGE
  [../]
  [./uy]
    order = FIRST
    family = LAGRANGE
  [../]
  [./uz]
    order = FIRST
    family = LAGRANGE
  [../]
[]

[AuxVariables]
  [euler_angle_1]
    order = CONSTANT
    family = MONOMIAL
  []
  [euler_angle_2]
    order = CONSTANT
    family = MONOMIAL
  []
  [euler_angle_3]
    order = CONSTANT
    family = MONOMIAL
  []
  [temperature]
    order = CONSTANT
    family = MONOMIAL
    initial_condition = 293.0
  []
  [./fp_zz]
    order = CONSTANT
    family = MONOMIAL
  [../]  
  [./gamma_qp]
    family = MONOMIAL
    order  = CONSTANT
  [../]
  
[]

